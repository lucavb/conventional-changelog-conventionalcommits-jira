{
    "name": "conventional-changelog-conventionalcommits-jira",
    "version": "2.0.1",
    "description": "A conventional-changelog preset for JIRA ticket references in conventional commits",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lucavb/conventional-changelog-conventionalcommits-jira.git"
    },
    "keywords": [
        "conventional-changelog",
        "conventionalcommits",
        "jira",
        "changelog",
        "conventional-commits"
    ],
    "homepage": "https://github.com/lucavb/conventional-changelog-conventionalcommits-jira",
    "bugs": {
        "url": "https://github.com/lucavb/conventional-changelog-conventionalcommits-jira/issues"
    },
    "files": [
        "CHANGELOG.md",
        "LICENSE.md",
        "README.md",
        "dist",
        "typings"
    ],
    "scripts": {
        "build": "rollup -c",
        "format": "prettier -w --ignore-unknown .",
        "lint": "eslint src",
        "prepack": "npm run build",
        "publishd": "npm publish --dry-run",
        "release": "semantic-release",
        "test": "vitest run",
        "test:ci": "vitest run --reporter=verbose"
    },
    "author": {
        "email": "luca.becker@me.com",
        "name": "Luca Becker",
        "url": "https://sunbury.xyz"
    },
    "dependencies": {
        "conventional-changelog-conventionalcommits": "7.0.2",
        "tslib": "2.6.2"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "25.0.7",
        "@rollup/plugin-node-resolve": "15.2.3",
        "@rollup/plugin-terser": "0.4.4",
        "@rollup/plugin-typescript": "11.1.6",
        "@semantic-release/commit-analyzer": "^13.0.0",
        "@semantic-release/github": "^12.0.0",
        "@semantic-release/npm": "^13.0.0",
        "@semantic-release/release-notes-generator": "^14.0.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "eslint": "8.57.0",
        "prettier": "3.2.4",
        "rollup": "4.9.6",
        "semantic-release": "^25.0.0",
        "typescript": "5.8.3",
        "vitest": "^4.1.9"
    },
    "exports": {
        ".": {
            "import": "./dist/conventional-changelog-conventionalcommits-jira.mjs",
            "require": "./dist/conventional-changelog-conventionalcommits-jira.cjs",
            "types": "./dist/src/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/src/index.d.ts",
    "publishConfig": {
        "access": "public"
    }
}
